{
    "name": "mdviewer-vscode",
    "displayName": "MD/CSV/TSV/JSONL Viewer",
    "description": "View Markdown and tables, plus preview the active CSV/TSV/JSONL row beside VS Code's native editor.",
    "version": "0.1.14",
    "publisher": "ThanOguyn",
    "license": "MIT",
    "engines": {
        "vscode": "^1.88.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/thanoguyn/md-csv-tsv-viewer--vscode"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCustomEditor:mdviewer.viewer",
        "onCustomEditor:mdviewer.jsonlTableViewer",
        "onCommand:mdviewer.openView",
        "onCommand:mdviewer.openTablePreview",
        "onCommand:mdviewer.openEdit",
        "onCommand:tabularViewer.previewRow",
        "onCommand:jsonlViewer.previewLine",
        "onCommand:jsonlViewer.previewNextRow",
        "onCommand:jsonlViewer.previewPreviousRow",
        "onCommand:jsonlViewer.previewGoToRow"
    ],
    "main": "./extension.js",
    "contributes": {
        "configurationDefaults": {
            "workbench.editorAssociations": {
                "*.md": "mdviewer.viewer",
                "*.markdown": "mdviewer.viewer",
                "*.mdown": "mdviewer.viewer",
                "*.mkd": "mdviewer.viewer",
                "*.csv": "mdviewer.viewer",
                "*.tsv": "mdviewer.viewer",
                "*.jsonl": "default",
                "*.ndjson": "default"
            },
            "workbench.diffEditorAssociations": {
                "*.md": "default",
                "*.markdown": "default",
                "*.mdown": "default",
                "*.mkd": "default",
                "*.csv": "default",
                "*.tsv": "default",
                "*.jsonl": "default",
                "*.ndjson": "default"
            }
        },
        "commands": [
            {
                "command": "mdviewer.openView",
                "title": "Open in MD Viewer",
                "category": "MD Viewer",
                "icon": "$(preview)"
            },
            {
                "command": "mdviewer.openEdit",
                "title": "Open as Text",
                "category": "MD Viewer",
                "icon": "$(edit)"
            },
            {
                "command": "mdviewer.openTablePreview",
                "title": "Open Table Viewer",
                "category": "MD Viewer",
                "icon": "$(table)"
            },
            {
                "command": "tabularViewer.previewRow",
                "title": "Preview Row",
                "category": "CSV/TSV",
                "icon": "$(json)",
                "enablement": "resourceExtname =~ /\\.(csv|tsv)$/ || editorLangId == csv || editorLangId == tsv"
            },
            {
                "command": "jsonlViewer.previewLine",
                "title": "Preview Row",
                "category": "JSONL",
                "icon": "$(json)",
                "enablement": "resourceExtname =~ /\\.(jsonl|ndjson)$/ || editorLangId == jsonl"
            },
            {
                "command": "jsonlViewer.previewNextRow",
                "title": "Preview Next Row",
                "category": "JSONL",
                "icon": "$(arrow-down)",
                "enablement": "jsonlViewer.previewActive"
            },
            {
                "command": "jsonlViewer.previewPreviousRow",
                "title": "Preview Previous Row",
                "category": "JSONL",
                "icon": "$(arrow-up)",
                "enablement": "jsonlViewer.previewActive"
            },
            {
                "command": "jsonlViewer.previewGoToRow",
                "title": "Preview Row by Number…",
                "category": "JSONL",
                "icon": "$(go-to-file)",
                "enablement": "jsonlViewer.previewActive || resourceExtname =~ /\\.(jsonl|ndjson)$/ || editorLangId == jsonl"
            }
        ],
        "customEditors": [
            {
                "viewType": "mdviewer.viewer",
                "displayName": "MD Viewer",
                "selector": [
                    {
                        "filenamePattern": "*.md"
                    },
                    {
                        "filenamePattern": "*.markdown"
                    },
                    {
                        "filenamePattern": "*.mdown"
                    },
                    {
                        "filenamePattern": "*.mkd"
                    },
                    {
                        "filenamePattern": "*.csv"
                    },
                    {
                        "filenamePattern": "*.tsv"
                    }
                ],
                "priority": "default"
            },
            {
                "viewType": "mdviewer.jsonlTableViewer",
                "displayName": "JSONL Table Viewer",
                "selector": [
                    {
                        "filenamePattern": "*.jsonl"
                    },
                    {
                        "filenamePattern": "*.ndjson"
                    }
                ],
                "priority": "option"
            }
        ],
        "keybindings": [
            {
                "command": "mdviewer.openView",
                "key": "ctrl+alt+v",
                "mac": "cmd+alt+v",
                "when": "editorTextFocus && resourceExtname =~ /\\.(md|markdown|mdown|mkd|csv|tsv|jsonl|ndjson)$/"
            },
            {
                "command": "jsonlViewer.previewLine",
                "key": "ctrl+alt+j",
                "mac": "cmd+alt+j",
                "when": "editorTextFocus && (resourceExtname =~ /\\.(jsonl|ndjson)$/ || editorLangId == jsonl)"
            },
            {
                "command": "tabularViewer.previewRow",
                "key": "ctrl+alt+j",
                "mac": "cmd+alt+j",
                "when": "editorTextFocus && (resourceExtname =~ /\\.(csv|tsv)$/ || editorLangId == csv || editorLangId == tsv)"
            },
            {
                "command": "jsonlViewer.previewNextRow",
                "key": "ctrl+alt+]",
                "mac": "cmd+alt+]",
                "when": "jsonlViewer.previewActive"
            },
            {
                "command": "jsonlViewer.previewPreviousRow",
                "key": "ctrl+alt+[",
                "mac": "cmd+alt+[",
                "when": "jsonlViewer.previewActive"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "mdviewer.openView",
                    "when": "resourceExtname =~ /\\.(md|markdown|mdown|mkd)$/",
                    "group": "navigation@1"
                },
                {
                    "command": "tabularViewer.previewRow",
                    "when": "(resourceExtname =~ /\\.(csv|tsv)$/ || editorLangId == csv || editorLangId == tsv) && activeCustomEditorId != 'mdviewer.viewer'",
                    "group": "navigation@1"
                },
                {
                    "command": "jsonlViewer.previewLine",
                    "when": "resourceExtname =~ /\\.(jsonl|ndjson)$/ || editorLangId == jsonl",
                    "group": "navigation@1"
                },
                {
                    "command": "mdviewer.openTablePreview",
                    "when": "resourceExtname =~ /\\.(csv|tsv|jsonl|ndjson)$/ && activeCustomEditorId != 'mdviewer.viewer' && activeCustomEditorId != 'mdviewer.jsonlTableViewer'",
                    "group": "navigation@2"
                },
                {
                    "command": "mdviewer.openEdit",
                    "when": "activeCustomEditorId == 'mdviewer.viewer' || activeCustomEditorId == 'mdviewer.jsonlTableViewer'",
                    "group": "navigation@1"
                }
            ],
            "editor/context": [
                {
                    "command": "mdviewer.openTablePreview",
                    "when": "resourceExtname =~ /\\.(csv|tsv|jsonl|ndjson)$/ && activeCustomEditorId != 'mdviewer.viewer' && activeCustomEditorId != 'mdviewer.jsonlTableViewer'",
                    "group": "1_jsonlviewer@0"
                },
                {
                    "command": "tabularViewer.previewRow",
                    "when": "resourceExtname =~ /\\.(csv|tsv)$/ || editorLangId == csv || editorLangId == tsv",
                    "group": "1_jsonlviewer@1"
                },
                {
                    "command": "jsonlViewer.previewLine",
                    "when": "resourceExtname =~ /\\.(jsonl|ndjson)$/ || editorLangId == jsonl",
                    "group": "1_jsonlviewer@1"
                },
                {
                    "command": "jsonlViewer.previewGoToRow",
                    "when": "resourceExtname =~ /\\.(jsonl|ndjson)$/ || editorLangId == jsonl",
                    "group": "1_jsonlviewer@2"
                },
                {
                    "command": "jsonlViewer.previewNextRow",
                    "when": "jsonlViewer.previewActive && (resourceExtname =~ /\\.(jsonl|ndjson)$/ || editorLangId == jsonl)",
                    "group": "1_jsonlviewer@3"
                },
                {
                    "command": "jsonlViewer.previewPreviousRow",
                    "when": "jsonlViewer.previewActive && (resourceExtname =~ /\\.(jsonl|ndjson)$/ || editorLangId == jsonl)",
                    "group": "1_jsonlviewer@4"
                }
            ]
        },
        "configuration": {
            "title": "MD/CSV/TSV/JSONL Viewer",
            "properties": {
                "tabularViewer.followCursor": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically update the side preview when the cursor moves between CSV/TSV rows."
                },
                "jsonlViewer.followCursor": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically update the side preview when the cursor moves between JSONL rows."
                }
            }
        }
    },
    "scripts": {
        "lint": "node --check extension.js && node --check jsonlPreview.js && node --check jsonlPreviewCore.js && node --check tabularRowPreview.js && node --check tabularRowPreviewCore.js && node --check media/vscodeViewer.js && node --check media/markdown.js && node --check media/markdownEnhancer.js && node --check media/tabular.js && node --check media/jsonl.js",
        "test": "node --test test/*.test.js",
        "package": "rm -f mdviewer-vscode-*.vsix && vsce package",
        "publish": "vsce publish",
        "local": "NODE_NO_WARNINGS=1 devin-desktop --install-extension mdviewer-vscode-${npm_package_version}.vsix",
        "code": "NODE_NO_WARNINGS=1 code --install-extension mdviewer-vscode-${npm_package_version}.vsix",
        "agy": "NODE_NO_WARNINGS=1 agy-ide --install-extension mdviewer-vscode-${npm_package_version}.vsix",
        "all": "npm run lint && npm run package && npm run local && npm run code && npm run agy"
    },
    "devDependencies": {
        "@types/vscode": "^1.88.0",
        "dompurify": "^3.4.14",
        "html2canvas": "^1.4.1",
        "jspdf": "^4.2.1",
        "marked": "^18.0.10"
    }
}
